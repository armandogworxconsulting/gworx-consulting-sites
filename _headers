# Cloudflare Pages response headers.
# Serve-time config lives here, not in .htaccess — Pages is not Apache.
# Compression (gzip/Brotli) is automatic and needs no configuration.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Images and icons: filenames are stable, so cache them hard.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS ARE content-hashed by build.mjs, so a change produces a new
# filename that nobody can have cached. That makes a year safe here: edits
# take effect on the next page load rather than waiting for an expiry.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# HTML always revalidates so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
